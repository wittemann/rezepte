# Copy to `.env` and fill in. Never commit `.env`. See docs/specs/06-deployment.md.

# scrypt hash of the shared password: `npm run hash-password`
APP_PASSWORD_HASH=
# random, 32+ bytes: `openssl rand -base64 32`
SESSION_SECRET=
# Airtable Personal Access Token, scoped to this base only
AIRTABLE_TOKEN=
# app…
AIRTABLE_BASE_ID=
