{
  "name": "rezepte",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Private recipe app for family and friends, backed by Airtable",
  "author": "Martin Wittemann",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "hash-password": "node scripts/hash-password.ts",
    "airtable:schema": "node --env-file=.env scripts/airtable-schema.ts"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/vercel": "^11.0.11",
    "astro": "^7.3.5",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
