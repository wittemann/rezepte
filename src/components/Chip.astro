---
// Filter chip (design/README.md, "Filter-Sheet"). Active = accent. Three kinds:
// - with `name`: a checkbox in a form. Used in the filter sheet of the recipe list (the page
//   renders it and passes it into the FilterSheet island as children)
// - with `href`: a link (filter in the URL); no user yet
// - otherwise a toggle button; no user yet
type Props = {
  label: string;
  active?: boolean;
  href?: string;
  /** Checkbox: field name, value and initial state */
  name?: string;
  value?: string;
  checked?: boolean;
};

const { label, active = false, href, name, value = 'on', checked = false } = Astro.props;
---

{name !== undefined ? (
  <label class="chip checkbox">
    <input class="input" type="checkbox" {name} {value} {checked} />
    {label}
  </label>
) : href ? (
  <a class="chip" href={href} aria-current={active ? 'true' : undefined} data-active={active}>
    {label}
  </a>
) : (
  <button class="chip" type="button" aria-pressed={active} data-active={active}>
    {label}
  </button>
)}

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--chip-height);
    padding: 0 var(--space-l);
    border: var(--border);
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--ink);
    font-size: 0.875rem; /* 14px */
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .chip[data-active='true'],
  .checkbox:has(:checked) {
    background: var(--accent);
    color: var(--on-accent);
  }

  /* The checkbox covers the chip, so the whole chip is tappable and stays focusable */
  .checkbox {
    position: relative;
  }

  .checkbox:has(:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
</style>
