---
// Filter chip in the filter sheet (design/README.md, "Filter-Sheet"). Active = accent.
// With `href` it is a link (filter in the URL), otherwise a toggle button.
interface Props {
  label: string;
  active?: boolean;
  href?: string;
}

const { label, active = false, href } = Astro.props;
---

{href ? (
  <a class="chip" href={href} aria-current={active ? 'true' : undefined} data-active={active}>
    {label}
  </a>
) : (
  <button class="chip" type="button" aria-pressed={active} data-active={active}>
    {label}
  </button>
)}

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--chip-height);
    padding: 0 var(--space-l);
    border: var(--border);
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--ink);
    font-size: 0.875rem; /* 14px */
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .chip[data-active='true'] {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
