---
// Plain error message with a link back to the start page (docs/specs/05-design-integration.md,
// "Plain error pages"). Used by the 404 and 500 pages.
type Props = {
  title: string;
  message: string;
  linkText: string;
  href?: string;
};

const { title, message, linkText, href = '/' } = Astro.props;
---

<main>
  <h1>{title}</h1>
  <p>{message}</p>
  <a {href}>{linkText}</a>
</main>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-l);
    /* Fills the body exactly (body has min-height 100dvh and the safe-top padding), so no scrolling */
    min-height: calc(100dvh - var(--safe-top));
    padding: var(--space-page);
    text-align: center;
  }

  p {
    color: var(--muted);
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-xl);
    color: var(--ink);
    text-decoration: none;
    border-bottom: var(--border);
  }
</style>
