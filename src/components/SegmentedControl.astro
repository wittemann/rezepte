---
// Choice of one out of a few (design/README.md: meal "Alle · Frühstück · Abend · Backen",
// "Wie viel Zeit?"). Sunk track, the active option is raised with surface and border.
// An option with `href` is a link (state in the URL), otherwise a toggle button.
// Options may have a second line (`hint`).
export type SegmentedOption = {
  label: string;
  hint?: string;
  active: boolean;
  href?: string;
};

type Props = {
  /** Names the group for screen readers */
  label: string;
  options: SegmentedOption[];
};

const { label, options } = Astro.props;
---

<div class="control" role="group" aria-label={label}>
  {options.map((option) => {
    const Tag = option.href ? 'a' : 'button';
    return (
      <Tag
        class:list={['option', { withHint: option.hint }]}
        href={option.href}
        type={option.href ? undefined : 'button'}
        aria-current={option.href && option.active ? 'true' : undefined}
        aria-pressed={option.href ? undefined : option.active}
        data-active={option.active}
      >
        <span class="label">{option.label}</span>
        {option.hint && <span class="hint">{option.hint}</span>}
      </Tag>
    );
  })}
</div>

<style>
  .control {
    display: flex;
    gap: var(--segmented-gap);
    padding: var(--segmented-padding);
    border-radius: var(--radius-card);
    background: var(--sunk);
  }

  .option {
    flex: 1;
    min-height: var(--chip-height);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.1;
    /* Transparent border keeps the size the same as the active one */
    border: 2px solid transparent;
    border-radius: calc(var(--radius-card) - var(--segmented-padding));
    background: transparent;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .option[data-active='true'] {
    background: var(--surface);
    border-color: var(--outline);
    color: var(--ink);
  }

  .label {
    font-size: 0.8125rem; /* 13px */
    font-weight: 800;
  }

  .withHint .label {
    font-size: 0.875rem; /* 14px */
  }

  .hint {
    font-size: var(--font-size-min);
    font-weight: 700;
    opacity: 0.8;
  }
</style>
