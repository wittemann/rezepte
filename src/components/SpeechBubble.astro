---
// Maulti's speech bubble (design/README.md, "Start"): small muted line above a headline.
// The pointed corner is the bottom left, towards Maulti.
type Props = {
  /** Small line, e.g. the greeting */
  lead: string;
  headline: string;
  /** Heading element of the headline; h1 suits the start page */
  headingLevel?: 'h1' | 'h2' | 'h3';
};

const { lead, headline, headingLevel: Heading = 'h1' } = Astro.props;
---

<div class="bubble">
  <p class="lead">{lead}</p>
  <Heading class="headline">{headline}</Heading>
</div>

<style>
  .bubble {
    padding: var(--space-l) var(--space-xl);
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius-l) var(--radius-l) var(--radius-l) var(--radius-tail);
    box-shadow: var(--shadow-m);
  }

  .lead {
    color: var(--muted);
    font-size: 0.875rem; /* 14px */
    font-weight: 700;
  }

  .headline {
    margin-top: 0.125rem; /* 2px */
    font-family: var(--font-display);
    font-size: 1.375rem; /* 22px */
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
  }
</style>
