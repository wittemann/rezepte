---
// Floating tab bar at the bottom (design/README.md, "Tab-Leiste"). Static links, no script.
// Pages pass which tab is active; the login page doesn't render it at all.
import Icon, { type IconName } from './Icon.tsx';
import { TEXT } from './TabBar.texts.ts';

export type TabId = 'home' | 'recipes' | 'favorites';

// "Neu" has no id: it opens the form and is never the active tab
const TABS: { id: TabId | null; href: string; label: string; icon: IconName }[] = [
  { id: 'home', href: '/', label: TEXT.home, icon: 'home' },
  { id: 'recipes', href: '/rezepte', label: TEXT.recipes, icon: 'search' },
  { id: 'favorites', href: '/favoriten', label: TEXT.favorites, icon: 'heart' },
  { id: null, href: '/neu', label: TEXT.create, icon: 'plus' },
];

type Props = {
  active: TabId;
};

const { active } = Astro.props;
---

<!-- Keeps the end of the page from hiding behind the fixed bar -->
<div class="clearance"></div>
<nav class="bar" aria-label={TEXT.navigation}>
  {TABS.map((tab) => (
    <a class="tab" href={tab.href} aria-current={tab.id === active ? 'page' : undefined}>
      <Icon
        name={tab.icon}
        strokeWidth={2.2}
        filled={tab.id === 'favorites' && tab.id === active}
      />
      <span class="label">{tab.label}</span>
    </a>
  ))}
</nav>

<style>
  .clearance {
    height: calc(var(--tab-bar-clearance) + var(--safe-bottom));
  }

  /* Fixed to the window but no wider than the app column, centered like the body */
  .bar {
    position: fixed;
    left: max(var(--safe-left), var(--space-m));
    right: max(var(--safe-right), var(--space-m));
    bottom: calc(var(--safe-bottom) + var(--space-m));
    max-width: calc(var(--app-max-width) - 2 * var(--space-m));
    height: var(--tab-bar-height);
    margin: 0 auto;
    display: flex;
    background: var(--surface);
    border: var(--border-thick);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-m);
  }

  .tab {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--tab-bar-gap);
    color: var(--muted);
    text-decoration: none;
  }

  .tab[aria-current='page'] {
    color: var(--ink);
  }

  /* Capped like iOS tab bars, which don't grow with the system text size either: four labels
     have to fit next to each other */
  .label {
    font-size: min(var(--font-size-min), 15px);
    font-weight: 800;
  }

  /* Dot under the active tab */
  .tab[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: var(--tab-bar-dot-offset);
    width: var(--tab-bar-dot-size);
    height: var(--tab-bar-dot-size);
    border-radius: var(--radius-pill);
    background: var(--accent);
  }
</style>
