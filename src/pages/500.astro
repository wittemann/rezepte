---
// 500 page (docs/specs/05-design-integration.md, "Plain error pages").
// Does not read the error, so no error details can leak to the visitor.
import Base from '../layouts/Base.astro';
import ErrorMessage from '../components/ErrorMessage.astro';
import { TEXT } from './_500.texts.ts';
---

<Base title={TEXT.title}>
  <ErrorMessage title={TEXT.title} message={TEXT.message} linkText={TEXT.linkText} />
</Base>
