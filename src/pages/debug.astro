---
// TEMPORARY: measures the iOS status bar area in the home-screen app (docs/bugs.md, top blur).
// Remove once the bug is understood. Behind the login like every page; no texts file on purpose.
import Base from '../layouts/Base.astro';
---

<Base title="Debug" withTimers={false}>
  <!-- Red: the top inset as the page sees it. Blue line: y = 0 of the page -->
  <div class="inset"></div>
  <div class="zero"></div>
  <main>
    <h1>Debug</h1>
    <pre id="values">…</pre>
    <div class="spacer">Scroll test</div>
  </main>
</Base>

<style>
  .inset {
    position: fixed;
    top: 0;
    left: 0;
    width: 50%;
    height: env(safe-area-inset-top, 0px);
    background: rgb(255 0 0 / 50%);
  }

  .zero {
    position: fixed;
    top: 0;
    right: 0;
    width: 50%;
    height: 2px;
    background: blue;
  }

  main {
    padding: 1rem 1.25rem;
  }

  pre {
    white-space: pre-wrap;
    font-size: 0.875rem;
  }

  .spacer {
    height: 150vh;
    padding-top: 1rem;
  }
</style>

<script>
  const probe = document.createElement('div');
  probe.style.cssText =
    'position:fixed;visibility:hidden;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)';
  document.body.append(probe);
  const probeStyle = getComputedStyle(probe);
  const modes = ['standalone', 'fullscreen', 'minimal-ui', 'browser'];

  document.getElementById('values')!.textContent = [
    `inset top: ${probeStyle.paddingTop}`,
    `inset bottom: ${probeStyle.paddingBottom}`,
    `display-mode: ${modes.find((mode) => matchMedia(`(display-mode: ${mode})`).matches)}`,
    `navigator.standalone: ${'standalone' in navigator ? String(navigator.standalone) : 'n/a'}`,
    `innerHeight: ${innerHeight}, screen.height: ${screen.height}`,
    `visualViewport: ${visualViewport?.height}`,
    `root font-size: ${getComputedStyle(document.documentElement).fontSize}`,
    `UA: ${navigator.userAgent}`,
  ].join('\n');
</script>
