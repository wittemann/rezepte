---
// Start page (design/README.md, "Start"): greeting, meal and time choice. Rendered on the server;
// meal and time live in the URL (docs/decisions/0006-forms-and-interactivity.md). Airtable errors
// are not caught: Astro shows the 500 page.
import { AIRTABLE_BASE_ID, AIRTABLE_TOKEN } from 'astro:env/server';
import CategoryGrid from '../components/CategoryGrid.astro';
import Maulti from '../components/Maulti.tsx';
import MealTiles from '../components/MealTiles.astro';
import RecipeRow from '../components/RecipeRow.astro';
import SegmentedControl from '../components/SegmentedControl.astro';
import SuggestionCarousel from '../components/SuggestionCarousel.astro';
import SpeechBubble from '../components/SpeechBubble.astro';
import Base from '../layouts/Base.astro';
import { CATEGORIES, MEALS } from '../lib/recipes/fields.ts';
import { sortFavorites } from '../lib/recipes/favorites.ts';
import { listHref } from '../lib/recipes/list-query.ts';
import { getAll } from '../lib/recipes/repository.ts';
import { matchingRecipes, suggestRecipes } from '../lib/recipes/suggestions.ts';
import {
  greetingFor,
  localDay,
  maxTotalMinutes,
  parseDiceSeed,
  parseStartQuery,
  startHref,
} from '../lib/start/start-query.ts';
import { TEXT } from './_index.texts.ts';

const MAX_FAVORITES = 4;

const now = new Date();
const state = parseStartQuery(Astro.url.searchParams, now);
const currentMeal = MEALS.find((entry) => entry.value === state.meal);
if (!currentMeal) throw new Error(`Unknown meal ${state.meal}`);

const recipes = await getAll({ token: AIRTABLE_TOKEN, baseId: AIRTABLE_BASE_ID });
const limit = { meal: state.meal, maxTotalMinutes: maxTotalMinutes(state) };
const matchingCount = matchingRecipes(recipes, limit).length;
const diceSeed = parseDiceSeed(Astro.url.searchParams);
const suggestions = suggestRecipes(recipes, { ...limit, day: localDay(now), diceSeed });

const favorites = sortFavorites(recipes);
const shownFavorites = favorites.slice(0, MAX_FAVORITES);
// Categories without recipes would lead to an empty list
const categories = CATEGORIES.map((category) => ({
  label: category.value,
  name: category.name,
  recipeCount: recipes.filter((recipe) => recipe.category === category.value).length,
  href: listHref({ query: '', filters: { categories: [category.value] } }),
})).filter((category) => category.recipeCount > 0);

const tiles = MEALS.map((entry) => ({
  label: TEXT.mealLabels[entry.name],
  mealName: entry.name,
  active: entry.value === state.meal,
  href: startHref({ ...state, meal: entry.value }),
}));
const timeOptions = [
  {
    label: TEXT.littleTime,
    hint: TEXT.littleTimeHint(state.meal === 'Backen'),
    active: state.time === 'little',
    href: startHref({ ...state, time: 'little' }),
  },
  {
    label: TEXT.muchTime,
    hint: TEXT.muchTimeHint,
    active: state.time === 'much',
    href: startHref({ ...state, time: 'much' }),
  },
];
---

<Base title={TEXT.title} activeTab="home">
  <main>
    <header class="greeting">
      <Maulti pose="wave" size={104} />
      <div class="bubble">
        <SpeechBubble
          lead={TEXT.greeting[greetingFor(now)]}
          headline={TEXT.headline[currentMeal.name]}
        />
      </div>
    </header>
    <div class="choice">
      <MealTiles label={TEXT.meals} {tiles} />
      <div class="time">
        <span class="timeLabel">{TEXT.time}</span>
        <div class="timeControl">
          <SegmentedControl label={TEXT.time} options={timeOptions} />
        </div>
      </div>
      <p class="matching">{TEXT.matching(matchingCount)}</p>
    </div>
    <SuggestionCarousel
      recipes={suggestions}
      mealName={currentMeal.name}
      rerollHref={startHref(state, diceSeed + 1)}
    />
    {shownFavorites.length > 0 && (
      <section class="section">
        <div class="sectionHeading">
          <h2 class="sectionTitle">{TEXT.favorites}</h2>
          <a class="more" href="/favoriten">
            {TEXT.allFavorites(favorites.length)}
          </a>
        </div>
        <div class="favorites">
          {shownFavorites.map((recipe) => (
            <RecipeRow {recipe} />
          ))}
        </div>
      </section>
    )}
    {categories.length > 0 && (
      <section class="section">
        <div class="sectionHeading">
          <h2 class="sectionTitle">{TEXT.browse}</h2>
        </div>
        <CategoryGrid {categories} />
      </section>
    )}
  </main>
</Base>

<style>
  .greeting {
    display: flex;
    align-items: flex-end;
    gap: var(--space-xs);
    padding: var(--space-s) var(--space-page) var(--space-xl);
  }

  .bubble {
    flex: 1;
    min-width: 0;
  }

  .choice {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: 0 var(--space-page);
  }

  .time {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .timeLabel {
    font-size: 0.875rem; /* 14px */
    font-weight: 800;
  }

  .timeControl {
    flex: 1;
  }

  .matching {
    color: var(--muted);
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: 0 var(--space-xl) var(--space-xxl);
  }

  .sectionHeading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: 0 0.25rem; /* 4px */
  }

  .sectionTitle {
    font-size: 1.1875rem; /* 19px */
  }

  .more {
    padding: var(--space-s) 0;
    color: var(--accent);
    font-size: 0.875rem; /* 14px */
    font-weight: 800;
    text-decoration: none;
  }

  .favorites {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
</style>
