---
// Recipe page (design/README.md, "Rezept-Detail"). Rendered on every request from the cached
// recipe table (docs/decisions/0003-rendering-and-caching.md). Airtable errors are not caught:
// Astro shows the 500 page.
import { AIRTABLE_BASE_ID, AIRTABLE_TOKEN } from 'astro:env/server';
import CookButton from '../../components/CookButton.astro';
import CookingLauncher from '../../components/CookingLauncher.tsx';
import ErrorMessage from '../../components/ErrorMessage.astro';
import Ingredients from '../../components/Ingredients.tsx';
import Notes from '../../components/Notes.astro';
import RecipeHeader from '../../components/RecipeHeader.astro';
import RecipeMeta from '../../components/RecipeMeta.astro';
import SavedToast, { SAVED_PARAM } from '../../components/SavedToast.tsx';
import StubNotice from '../../components/StubNotice.astro';
import Steps from '../../components/Steps.astro';
import Base from '../../layouts/Base.astro';
import { cookingSteps } from '../../lib/recipes/cooking-steps.ts';
import { getById } from '../../lib/recipes/repository.ts';
import { TEXT } from './_[id].texts.ts';

const recipe = await getById(
  { token: AIRTABLE_TOKEN, baseId: AIRTABLE_BASE_ID },
  Astro.params.id ?? '',
);
// The generic 404 page only says "Seite nicht gefunden"
if (!recipe) Astro.response.status = 404;
// Set by the edit form after saving
const justSaved = Astro.url.searchParams.has(SAVED_PARAM);
const steps = recipe ? cookingSteps(recipe.method) : [];
---

{recipe ? (
  <Base title={recipe.title}>
    {/* Hidden by CookingLauncher while cooking */}
    <main data-recipe-page>
      <RecipeHeader {recipe} />
      <RecipeMeta {recipe} />
      {!recipe.hasInstructions && <StubNotice editHref={`/recipes/${recipe.id}/edit`} />}
      {recipe.ingredients.length > 0 && (
        <Ingredients client:load ingredients={recipe.ingredients} servings={recipe.servings} />
      )}
      {recipe.hasInstructions && <Steps method={recipe.method} category={recipe.category} />}
      {recipe.notes && <Notes notes={recipe.notes} />}
      {recipe.hasInstructions && <CookButton href={`/recipes/${recipe.id}/cook`} />}
    </main>
    {steps.length > 0 && (
      <CookingLauncher
        client:idle
        recipeId={recipe.id}
        recipeHref={`/recipes/${recipe.id}`}
        cookHref={`/recipes/${recipe.id}/cook`}
        hasPhoto={recipe.images.length > 0}
        {steps}
        ingredients={recipe.ingredients}
        servings={recipe.servings}
      />
    )}
    {justSaved && <SavedToast client:load />}
  </Base>
) : (
  <Base title={TEXT.notFoundTitle}>
    <ErrorMessage
      title={TEXT.notFoundTitle}
      message={TEXT.notFoundMessage}
      linkText={TEXT.notFoundLink}
      href="/recipes"
    />
  </Base>
)}

<style>
  main {
    padding-top: var(--space-s);
    padding-bottom: var(--space-page);
  }
</style>
