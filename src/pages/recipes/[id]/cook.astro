---
// Cooking mode of a recipe (design/README.md, "Kochmodus"). Rendered live from Airtable like the
// recipe page. A recipe without instructions has nothing to cook: back to the recipe page.
// `?servings=` carries the servings chosen on the recipe page.
import { AIRTABLE_BASE_ID, AIRTABLE_TOKEN } from 'astro:env/server';
import CookingMode from '../../../components/CookingMode.tsx';
import ErrorMessage from '../../../components/ErrorMessage.astro';
import Base from '../../../layouts/Base.astro';
import { cookingSteps } from '../../../lib/recipes/cooking-steps.ts';
import { getById } from '../../../lib/recipes/repository.ts';
import { SERVINGS_PARAM, parseServings } from '../../../lib/recipes/servings.ts';
import { TEXT } from '../_[id].texts.ts';

const recipe = await getById(
  { token: AIRTABLE_TOKEN, baseId: AIRTABLE_BASE_ID },
  Astro.params.id ?? '',
);
const steps = recipe ? cookingSteps(recipe.method) : [];
const chosenServings = parseServings(Astro.url.searchParams.get(SERVINGS_PARAM));

if (recipe && steps.length === 0) return Astro.redirect(`/recipes/${recipe.id}`);
if (!recipe) Astro.response.status = 404;
---

{recipe ? (
  <Base title={recipe.title}>
    <CookingMode
      client:load
      recipeId={recipe.id}
      hasPhoto={recipe.images.length > 0}
      rating={recipe.rating}
      recipeHref={`/recipes/${recipe.id}`}
      steps={steps}
      ingredients={recipe.ingredients}
      servings={recipe.servings}
      {chosenServings}
    />
  </Base>
) : (
  <Base title={TEXT.notFoundTitle}>
    <ErrorMessage
      title={TEXT.notFoundTitle}
      message={TEXT.notFoundMessage}
      linkText={TEXT.notFoundLink}
      href="/recipes"
    />
  </Base>
)}
