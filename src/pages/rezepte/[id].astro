---
// Recipe page (design/README.md, "Rezept-Detail"). Rendered live from Airtable, no caching
// (docs/decisions/0003-rendering-and-caching.md). Airtable errors are not caught: Astro shows
// the 500 page.
import { AIRTABLE_BASE_ID, AIRTABLE_TOKEN } from 'astro:env/server';
import RecipeHeader from '../../components/RecipeHeader.astro';
import Base from '../../layouts/Base.astro';
import { getById } from '../../lib/recipes/repository.ts';

const recipe = await getById(
  { token: AIRTABLE_TOKEN, baseId: AIRTABLE_BASE_ID },
  Astro.params.id ?? '',
);
if (!recipe) return Astro.rewrite('/404');
---

<Base title={recipe.title}>
  <main>
    <RecipeHeader {recipe} />
  </main>
</Base>

<style>
  main {
    padding-top: var(--space-s);
    padding-bottom: var(--space-page);
  }
</style>
